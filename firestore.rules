rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() && currentUser().data.role == "super_admin";
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "company_admin";
      allow read: if signedIn()
        && (request.auth.uid == uid || isSuperAdmin());
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.companyId == resource.data.companyId;
    }

    match /companies/{companyId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn()
        && (isSuperAdmin() || currentUser().data.companyId == companyId);
      allow update: if signedIn()
        && (isSuperAdmin() || resource.data.ownerUid == request.auth.uid);
    }
  }
}
