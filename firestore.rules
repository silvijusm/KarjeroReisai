rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // This role can only be provisioned by a trusted administrator / Admin SDK.
    function isSuperAdmin() {
      return signedIn() && currentUser().data.role == 'super_admin';
    }
    // Trial length (30 days). Must match TRIAL_DAYS in AuthViewModel.kt.
    function trialMs() { return 2592000000; }
    function validName(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }
    function validProfile(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'companyId', 'createdAt'])
        && data.keys().hasOnly(['email', 'name', 'role', 'companyId', 'createdAt'])
        && validName(data.name)
        && data.email is string
        && data.email == request.auth.token.email
        && data.companyId is string && data.companyId.size() > 0;
    }
    function member(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }
    // Owner = the company_admin who registered the company (no members record needed).
    function isCompanyOwner(companyId) {
      return signedIn() && currentUser().data.companyId == companyId
        && currentUser().data.role in ['company_admin', 'super_admin']
        && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
    }
    // Approved member whose server-written profile still points to this company.
    function isActiveMember(companyId) {
      return signedIn() && currentUser().data.companyId == companyId
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && member(companyId).data.status == 'active'
        && member(companyId).data.role == currentUser().data.role;
    }
    function isCompanyAdmin(companyId) {
      return isSuperAdmin() || isCompanyOwner(companyId)
        || (isActiveMember(companyId) && member(companyId).data.role == 'company_admin');
    }
    // Admins and dispatchers: see all drivers, vehicles and (later) the live map.
    function isManager(companyId) {
      return isCompanyAdmin(companyId)
        || (isActiveMember(companyId) && member(companyId).data.role == 'dispatcher');
    }
    // Owner or approved member may record work for the company.
    function canWork(companyId) {
      return isCompanyOwner(companyId) || isActiveMember(companyId);
    }
    function validSession(data) {
      return data.keys().hasOnly(['driverUid', 'driverName', 'plate', 'trailer', 'loadingPlace', 'unloadingPlace',
          'date', 'startedAtMillis', 'endedAtMillis', 'tripsCount', 'tonnes', 'km', 'trips', 'updatedAtMillis',
          'vehicleId', 'objectId', 'contractorId'])
        && data.driverUid == request.auth.uid
        && data.startedAtMillis is int
        && (!('trips' in data) || (data.trips is list && data.trips.size() <= 300))
        && (!('plate' in data) || (data.plate is string && data.plate.size() <= 40));
    }
    function validRoute(data) {
      return data.keys().hasOnly(['driverUid', 'lat', 'lng', 't', 'firstMillis'])
        && data.driverUid == request.auth.uid
        && data.lat is list && data.lat.size() <= 500
        && data.lng is list && data.lng.size() == data.lat.size()
        && data.t is list && data.t.size() == data.lat.size();
    }
    function validLive(data) {
      return data.keys().hasOnly(['lat', 'lng', 'speedKmh', 'heading', 'accuracyM', 'updatedAtMillis', 'sessionId',
          'plate', 'driverName', 'state', 'tripsCount', 'tonnes', 'startedAtMillis', 'objectId'])
        && data.keys().hasAll(['state', 'updatedAtMillis'])
        && data.state in ['moving', 'stopped', 'loading', 'unloading', 'offline'];
    }
    function myCompany() {
      return currentUser().data.companyId;
    }
    function isActiveLoader(companyId) {
      return isActiveMember(companyId) && member(companyId).data.role == 'loader';
    }
    // The caller works for a carrier company that the contractor approved on this object.
    function isApprovedCarrier(companyId, objectId) {
      return signedIn() && canWork(myCompany())
        && get(/databases/$(database)/documents/companies/$(companyId)/objects/$(objectId)/carriers/$(myCompany())).data.status == 'active';
    }
    function validObject(data) {
      return data.keys().hasOnly(['name', 'objectCode', 'status', 'joinCode', 'sender', 'receiver',
          'quarryName', 'quarryLat', 'quarryLng', 'quarryRadiusM', 'unloadName', 'unloadLat', 'unloadLng', 'unloadRadiusM',
          'distanceKm', 'materials', 'vehicleTonnes', 'allowLoaderOverride', 'gpsWarnPct', 'waybillSeries', 'createdAtMillis', 'updatedAtMillis'])
        && validName(data.name)
        && data.status in ['active', 'finished']
        && (!('materials' in data) || (data.materials is list && data.materials.size() <= 30));
    }
    function validObjectLive(data) {
      return data.keys().hasOnly(['lat', 'lng', 'speedKmh', 'heading', 'accuracyM', 'updatedAtMillis', 'sessionId',
          'plate', 'driverName', 'state', 'tripsCount', 'tonnes', 'startedAtMillis', 'objectId', 'carrierId', 'carrierName'])
        && data.keys().hasAll(['state', 'updatedAtMillis'])
        && data.state in ['moving', 'stopped', 'loading', 'unloading', 'offline']
        && (!('carrierId' in data) || data.carrierId == myCompany());
    }
    function validLoad(data) {
      return data.keys().hasOnly(['plate', 'carrierId', 'carrierName', 'material', 'tonnes', 'm3', 'distanceKm',
          'loadedAtMillis', 'createdAtMillis', 'loaderUid', 'loaderName', 'source', 'note', 'status'])
        && data.loaderUid == request.auth.uid
        && data.status == 'loaded'
        && data.plate is string && data.plate.size() > 0 && data.plate.size() <= 20
        && data.carrierId is string
        && data.tonnes is number && data.tonnes > 0 && data.tonnes <= 100
        && data.loadedAtMillis is int;
    }
    function validVehicle(data) {
      return data.keys().hasAll(['plateNumber', 'name', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['plateNumber', 'name', 'active', 'createdAt', 'updatedAt'])
        && data.plateNumber is string && data.plateNumber.size() > 0 && data.plateNumber.size() <= 20
        && data.name is string && data.name.size() <= 100
        && data.active is bool;
    }
    function validCompany(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'plan', 'trialEndsAtMillis', 'createdAt'])
        && data.keys().hasOnly(['name', 'ownerUid', 'plan', 'trialEndsAtMillis', 'createdAt'])
        && validName(data.name);
    }
    match /users/{uid} {
      // Registration must atomically create BOTH the new company and its owner.
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.role == 'company_admin'
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerUid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Role, tenant membership, email and creation time are not client-editable.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
    }
    match /companies/{companyId} {
      allow create: if signedIn() && validCompany(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.plan == 'trial'
        && request.resource.data.createdAt == request.time
        && request.resource.data.trialEndsAtMillis is int
        // Keep the Android millisecond field; bound client clock skew to five minutes.
        && request.resource.data.trialEndsAtMillis >= request.time.toMillis() + trialMs() - 300000
        && request.resource.data.trialEndsAtMillis <= request.time.toMillis() + trialMs() + 300000
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company_admin';
      // Do not trust legacy profiles that may already contain a forged companyId.
      // Active members (drivers, dispatchers) may read name, plan and trial end.
      allow read: if signedIn() && (isSuperAdmin()
        || (resource.data.ownerUid == request.auth.uid
          && currentUser().data.companyId == companyId
          && currentUser().data.role == 'company_admin')
        || isActiveMember(companyId));
      // Billing, trial end and ownership changes require the trusted Admin SDK.
      allow update: if signedIn()
        && (isSuperAdmin() || (resource.data.ownerUid == request.auth.uid
          && currentUser().data.companyId == companyId
          && currentUser().data.role == 'company_admin'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
    }
    // Membership records are written only by Cloud Functions (joinCompany, approveMember ...).
    // A user may read their own record (to see "pending"); managers read the whole list.
    match /companies/{companyId}/members/{memberUid} {
      allow read: if signedIn() && (request.auth.uid == memberUid || isManager(companyId));
    }
    // Vehicles: every active member can read (to pick one), only admins edit. No deletes – set active=false.
    match /companies/{companyId}/vehicles/{vehicleId} {
      allow read: if isManager(companyId) || isActiveMember(companyId);
      allow create: if isCompanyAdmin(companyId) && validVehicle(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isCompanyAdmin(companyId) && validVehicle(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
    }
    // Work sessions: a driver writes only their own; managers read all of the company.
    // Removed drivers can no longer write, but their past sessions stay for reports.
    match /companies/{companyId}/sessions/{sessionId} {
      allow read: if signedIn() && (resource.data.driverUid == request.auth.uid || isManager(companyId));
      allow create: if canWork(companyId) && validSession(request.resource.data);
      allow update: if canWork(companyId) && validSession(request.resource.data)
        && resource.data.driverUid == request.auth.uid;
      match /route/{chunkId} {
        allow read: if signedIn() && (resource.data.driverUid == request.auth.uid || isManager(companyId));
        // Route points may only be added to the driver's own session.
        allow create: if canWork(companyId) && validRoute(request.resource.data)
          && get(/databases/$(database)/documents/companies/$(companyId)/sessions/$(sessionId)).data.driverUid == request.auth.uid;
        allow update: if canWork(companyId) && validRoute(request.resource.data)
          && resource.data.driverUid == request.auth.uid;
      }
    }
    // One live position document per driver, overwritten (cheap). Only managers see the map.
    match /companies/{companyId}/liveLocations/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager(companyId));
      allow create, update: if request.auth.uid == uid && canWork(companyId) && validLive(request.resource.data);
    }
    // ---- Contractor objects (road / building site), carriers and loads ----
    // Carriers see an object only while approved on it; the contractor sees a carrier's
    // vehicles only through the object (live/, loads/), never the carrier's other work.
    match /companies/{companyId}/objects/{objectId} {
      allow read: if isManager(companyId) || isActiveLoader(companyId) || isApprovedCarrier(companyId, objectId);
      allow create: if isCompanyAdmin(companyId) && validObject(request.resource.data)
        && !('joinCode' in request.resource.data);
      allow update: if isCompanyAdmin(companyId) && validObject(request.resource.data)
        && request.resource.data.get('joinCode', null) == resource.data.get('joinCode', null);

      match /carriers/{carrierId} {
        allow read: if isManager(companyId) || isActiveLoader(companyId) || (carrierId == myCompany() && canWork(carrierId));
      }
      match /live/{uid} {
        allow read: if isManager(companyId) || isActiveLoader(companyId);
        allow create, update: if request.auth.uid == uid && isApprovedCarrier(companyId, objectId)
          && validObjectLive(request.resource.data);
      }
      match /loads/{loadId} {
        allow read: if isManager(companyId) || isActiveLoader(companyId)
          || (signedIn() && resource.data.carrierId == myCompany() && canWork(myCompany()));
        // The excavator operator (or contractor admin) registers a load for an approved carrier.
        allow create: if (isActiveLoader(companyId) || isCompanyAdmin(companyId))
          && validLoad(request.resource.data)
          && get(/databases/$(database)/documents/companies/$(companyId)/objects/$(objectId)/carriers/$(request.resource.data.carrierId)).data.status == 'active';
        // Driver of the carrier confirms or disputes; cannot change tonnes or km.
        allow update: if (signedIn() && resource.data.carrierId == myCompany() && canWork(myCompany())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverUid', 'driverNote', 'confirmedAtMillis'])
            && request.resource.data.status in ['confirmed', 'disputed']
            && request.resource.data.driverUid == request.auth.uid)
          // Contractor corrects tonnes / km / material; every change is kept in history.
          || (isManager(companyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tonnes', 'm3', 'distanceKm', 'material', 'history', 'editedBy', 'editedAtMillis'])
            && request.resource.data.editedBy == request.auth.uid
            && request.resource.data.tonnes is number && request.resource.data.tonnes >= 0 && request.resource.data.tonnes <= 100
            && request.resource.data.history is list && request.resource.data.history.size() > resource.data.get('history', []).size())
          // The loader may cancel their own mistaken entry.
          || (isActiveLoader(companyId) && resource.data.loaderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled');
      }
    }
    // Objects a carrier company works on (written by the server when joining / approved).
    match /companies/{companyId}/objectLinks/{objectId} {
      allow read: if canWork(companyId) || isManager(companyId);
    }
    // companyCodes, objectCodes and rateLimits are server-only.
    // No client deletes; unmatched collections are denied by default.
  }
}
