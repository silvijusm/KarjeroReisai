{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "billing",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".env*",
        "test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run check",
        "npm --prefix \"$RESOURCE_DIR\" test"
      ]
    },
    {
      "source": "members",
      "codebase": "members",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".env*",
        "test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run check",
        "npm --prefix \"$RESOURCE_DIR\" test"
      ]
    }
  ],
  "hosting": {
    "public": "web",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": true
  }
}
