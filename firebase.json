{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "billing",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".env*",
        "test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run check",
        "npm --prefix \"$RESOURCE_DIR\" test"
      ]
    }
  ]
}
