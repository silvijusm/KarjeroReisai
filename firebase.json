{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "billing",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".env*",
        "test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run check",
        "npm --prefix \"$RESOURCE_DIR\" test"
      ]
    },
    {
      "source": "members",
      "codebase": "members",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".env*",
        "test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run check",
        "npm --prefix \"$RESOURCE_DIR\" test"
      ]
    }
  ],
  "hosting": {
    "public": "web",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=KarjeroReisai.apk"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/apk",
        "destination": "/KarjeroReisai.apk",
        "type": 302
      },
      {
        "source": "/pagalba",
        "destination": "/site/pagalba",
        "type": 302
      },
      {
        "source": "/svetaine",
        "destination": "/site/",
        "type": 302
      },
      {
        "source": "/privatumas",
        "destination": "/site/privacy",
        "type": 302
      },
      {
        "source": "/istrynimas",
        "destination": "/site/delete-account",
        "type": 302
      }
    ]
  }
}
