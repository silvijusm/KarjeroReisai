{
  "name": "karjeroreisai-security-tests",
  "version": "1.0.0",
  "description": "Firestore authorization regression tests",
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-karjeroreisai --only firestore \"node --test --test-concurrency=1 tests/firestore.rules.test.mjs\"",
    "deploy:members": "npm ci --prefix members --no-audit --no-fund && firebase deploy --project karjieroreisai --only firestore:rules,functions:members"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvijusm/KarjeroReisai.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/silvijusm/KarjeroReisai/issues"
  },
  "homepage": "https://github.com/silvijusm/KarjeroReisai#readme",
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.2"
  },
  "private": true
}
